# Pinned toolchain pieces. Bump deliberately: scripts/bootstrap.sh reinstalls
# whatever changed. The Swift version lives in .swift-version (read by swiftly).

# Xcode major whose iOS SDK matches .swift-version (Swift 6.4 = Xcode 27).
XCODE_MAJOR=27

# Linux iOS toolchain: install script, Linux actool/ibtool/momc stand-ins,
# App Store packaging (ship.sh) and device tooling (device-run.sh).
OMARCHY_APPLE_DEV_REPO=https://github.com/joshuaswarren/omarchy-apple-dev
OMARCHY_APPLE_DEV_REV=6f9116f9ddc6072acffae10ff737ad6cbefbcf5a

# libimobiledevice stack for building xtool on Debian/Ubuntu, whose packages
# are too old (xtool needs idevice_events_subscribe from libimobiledevice 1.4).
LIBPLIST_REV=2.6.0
LIBIMOBILEDEVICE_GLUE_REV=1.3.1
LIBUSBMUXD_REV=2.1.0
LIBTATSU_REV=1.0.4
LIBIMOBILEDEVICE_REV=1.4.0
