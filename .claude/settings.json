{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 3600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make build)",
      "Bash(make doctor)",
      "Bash(make setup)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift format:*)"
    ]
  }
}
